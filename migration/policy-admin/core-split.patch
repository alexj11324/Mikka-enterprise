diff --git a/lib/business/core-policy-admin.ts b/lib/business/core-policy-admin.ts
new file mode 100644
--- /dev/null
+++ b/lib/business/core-policy-admin.ts
@@ -0,0 +1,21 @@
+import type { z } from 'zod';
+/** Public-core-owned boundary. No SQL pool, signing private key or execution
+ * bypass is exposed to the enterprise management adapter. */
+export interface CorePolicyAdmin {
+  readonly signer: { readonly keyId: string; readonly publicKey: string };
+  read(workspaceId: string, actorId: string, version?: number): Promise<unknown>;
+  current(actorId: string, workspaceId: string): Promise<readonly { signed: unknown }[]>;
+  publish(workspaceId: string, actorId: string, expectedVersion: number,
+    document?: unknown, rollbackOf?: number): Promise<unknown>;
+}
+export interface CorePolicyContract {
+  readonly documentSchema: z.ZodType;
+  readonly PolicyError: new (code: string, status: number) => Error & {code: string; status: number};
+}
+export interface CorePolicyAdminRuntime {
+  admin(): CorePolicyAdmin;
+  readonly contract: CorePolicyContract;
+  readonly origin: string;
+  /** Must resolve a real browser session without cookie-cache authorization. */
+  authenticate(request: Request): Promise<{userId: string} | null>;
+}
diff --git a/lib/policy/admin-runtime.ts b/lib/policy/admin-runtime.ts
new file mode 100644
--- /dev/null
+++ b/lib/policy/admin-runtime.ts
@@ -0,0 +1,27 @@
+import "server-only";
+import { auth } from "@/lib/auth";
+import { appOrigin } from "@/lib/mcp/resource";
+import { policyStore } from "./runtime";
+import { documentSchema, PolicyError } from "./contract";
+import type { CorePolicyAdminRuntime } from "../business/core-policy-admin";
+/** Public capability facade: never expose pool or private signing material. */
+export function corePolicyAdminRuntime(): CorePolicyAdminRuntime {
+  return {
+    origin: appOrigin ?? "",
+    contract: { documentSchema, PolicyError },
+    authenticate: async request => {
+      const session = await auth.api.getSession({headers: request.headers, query:{disableCookieCache:true}});
+      return session ? {userId:session.user.id} : null;
+    },
+    admin: () => {
+      const store=policyStore();
+      return {
+        signer: Object.freeze({keyId:store.signer.keyId,publicKey:store.signer.publicKey}),
+        read: (workspace,actor,version)=>store.read(workspace,actor,version),
+        current: (actor,workspace)=>store.current(actor,workspace),
+        publish: (workspace,actor,version,document,rollback)=>store.publish(workspace,actor,version,
+          document===undefined ? undefined : documentSchema.parse(document),rollback),
+      };
+    },
+  };
+}
