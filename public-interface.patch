+++ b/lib/business/contract.ts
@@ -0,0 +1,15 @@
+/** Public v1 extension seam. Discovery metadata is never an authorization,
+ * quota allocation, credential grant, audit exemption or execution decision. */
+export interface BusinessExtension {
+  readonly apiVersion: 1
+  readonly distribution: 'community' | 'enterprise'
+  readonly managementModules: readonly string[]
+}
+export function validateBusinessExtension(value: BusinessExtension): BusinessExtension {
+  if (value.apiVersion !== 1 || !['community', 'enterprise'].includes(value.distribution) ||
+      !Array.isArray(value.managementModules) || value.managementModules.some(id => !/^[a-z][a-z0-9-]{0,63}$/.test(id))) {
+    throw new Error('Unsupported business extension contract')
+  }
+  return Object.freeze({apiVersion: 1, distribution: value.distribution,
+    managementModules: Object.freeze([...new Set(value.managementModules)])})
+}
